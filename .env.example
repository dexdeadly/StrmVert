# ─────────────────────────────────────────────────────────────────────────────
# StrmVert configuration. Copy to .env and edit.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Signs the login session cookie AND derives the key that encrypts
# stored Xtream Codes passwords in the database. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later invalidates sessions and makes existing stored XC
# passwords unreadable (re-enter them in the UI).
SECRET_KEY=

# OPTIONAL. If set, the whole UI sits behind a single-password login.
# Leave blank for an open app (only do that on a trusted LAN / behind a proxy).
APP_PASSWORD=

# Host path (or named volume) mounted at /VODS in the container — where the
# generated .strm / .nfo files are written for Jellyfin/Emby to scan.
MEDIA_ROOT=/VODS

# Library sub-folder names under MEDIA_ROOT.
MOVIES_DIR=Movies
TV_DIR=TV Shows

# Write Kodi/Jellyfin .nfo files next to each .strm (true/false).
WRITE_NFO=true

# Auto re-sync every active server every N hours. 0 disables the scheduler.
# This is only the initial value — change it live on the Settings page.
SYNC_INTERVAL_HOURS=0

# Xtream API tuning.
HTTP_TIMEOUT=30
XC_MAX_CONCURRENCY=5

# Metadata source — TMDB. All three can also be set on the Settings page.
# TMDB_API_KEY accepts a v3 API key or a v4 read-access token.
TMDB_ENABLED=false
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Path/filename templates. {title}/{show}/{year}/{season}/{episode} are filled in.
MOVIE_FOLDER_TEMPLATE={title} ({year})
MOVIE_FILE_TEMPLATE={title} ({year})
TV_SHOW_FOLDER_TEMPLATE={show} ({year})
TV_SEASON_TEMPLATE=Season {season:02d}
TV_EPISODE_TEMPLATE={show} S{season:02d}E{episode:02d}

# Set to 1 only for local dev — allows booting without a strong SECRET_KEY.
DEV=0
